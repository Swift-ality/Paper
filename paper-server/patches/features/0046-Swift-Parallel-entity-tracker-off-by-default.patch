Subject: [PATCH] Swift: Parallel entity tracker (off by default)


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index fd0b9f20fbdd523d51550fd6009b5011e6e7e6e6..4df6275e6d3040e48259f2bbfb27a64d939b3f8f 100644
--- a/net/minecraft/server/level/ChunkMap.java
