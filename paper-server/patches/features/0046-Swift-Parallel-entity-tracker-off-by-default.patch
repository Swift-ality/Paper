@@ -1098,22 +1098,43 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         try {
             final ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.world.entity.Entity> trackerEntities = this.trackerEntities;
             final Entity[] trackerEntitiesRaw = trackerEntities.getRawDataUnchecked();
+            // Swift start - async tracker: track entities on the worker threads (packets only, gameplay unchanged)
+            final int swift$size = trackerEntities.size();
+            if (io.papermc.paper.swift.async.SwiftAsync.trackerEnabled && swift$size >= io.papermc.paper.swift.async.SwiftAsync.trackerMinParallel) {
+                final java.util.List<Entity> swift$parallel = new java.util.ArrayList<>(swift$size);
+                final java.util.List<Entity> swift$sync = new java.util.ArrayList<>();
+                for (int i = 0; i < swift$size; ++i) {
+                    final Entity entity = trackerEntitiesRaw[i];
+                    // players (their own connection state) and item frames (map data shared between frames) stay on the main thread
+                    (entity instanceof ServerPlayer || entity instanceof net.minecraft.world.entity.decoration.ItemFrame ? swift$sync : swift$parallel).add(entity);
+                }
+                io.papermc.paper.swift.async.SwiftAsync.forEachParallel(swift$parallel, this::swift$trackEntity);
+                io.papermc.paper.swift.async.SwiftAsync.PARALLEL_TRACKER_TICKS.incrementAndGet();
+                swift$sync.forEach(this::swift$trackEntity);
+                return;
+            }
+            // Swift end - async tracker
             for (int i = 0, len = trackerEntities.size(); i < len; ++i) {
                 final Entity entity = trackerEntitiesRaw[i];
+                this.swift$trackEntity(entity); // Swift - async tracker: loop body moved to a method
+            }
+        } finally {
+            this.iteratingTrackerEntities = false;
+        }
+    }
+    // Swift start - async tracker: one entity's tracker update (the original loop body)
+    private void swift$trackEntity(final Entity entity) {
                 final ChunkMap.TrackedEntity tracker = ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
                 if (tracker == null) {
-                    continue;
+                    return;
                 }
                 ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$tick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers);
                 if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$hasPlayers()
                     || ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
                     tracker.serverEntity.sendChanges();
                 }
-            }
-        } finally {
-            this.iteratingTrackerEntities = false;
-        }
     }
+    // Swift end - async tracker
     // Paper end - optimise entity tracker
 
     protected void tick() {
