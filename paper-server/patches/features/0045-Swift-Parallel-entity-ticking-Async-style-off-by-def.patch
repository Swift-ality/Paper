+    private EntityCollectionBySection swift$classCollection(final Class<? extends Entity> clazz) {
+        final boolean held = io.papermc.paper.swift.async.SwiftAsync.lock();
+        try {
+            EntityCollectionBySection collection = this.entitiesByClass.get(clazz);
+            if (collection == null) {
+                collection = this.initClass(clazz);
+                final Reference2ObjectOpenHashMap<Class<? extends Entity>, EntityCollectionBySection> copy = new Reference2ObjectOpenHashMap<>(this.entitiesByClass);
+                copy.put(clazz, collection);
+                this.entitiesByClass = copy;
+            }
+            return collection;
+        } finally {
+            io.papermc.paper.swift.async.SwiftAsync.unlock(held);
+        }
+    }
+    // Swift end - async entities
