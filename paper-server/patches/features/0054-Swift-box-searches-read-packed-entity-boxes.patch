-    private static final class BasicEntityList<E extends Entity> {
+    // Swift start - packed boxes: box searches over the "all entities" section lists (pushing, getEntities without a
+    // class, ...) read each entity's bounding box from a flat array kept next to the list, in list order, instead of
+    // following entity -> AABB for every entity in the section. The array always equals the entities' boxes:
+    // Entity#setBoundingBox (the only writer of Entity.bb) updates it, and adding, removing and compacting move
+    // the copies along with the entities. The search compares exactly like AABB#intersects, so it finds the same
+    // entities in the same order. During the parallel entity phase box changes only mark the list stale (no thread
+    // writes an array another may be resizing); stale lists are rebuilt right after the phase, and searches during
+    // the phase, or on a stale list, use the entities' own boxes. Disable with -Dswift.packedBoxes=false.
+    public static final boolean SWIFT$PACKED_BOXES = Boolean.parseBoolean(System.getProperty("swift.packedBoxes", "true"));
+    /** Not final so tests can compare both paths inside one server (the arrays are kept up to date either way). */
+    public static volatile boolean swift$readPackedBoxes = SWIFT$PACKED_BOXES;
+    private static final java.util.concurrent.ConcurrentLinkedQueue<BasicEntityList<?>> SWIFT$STALE = new java.util.concurrent.ConcurrentLinkedQueue<>();
+    public static final java.util.concurrent.atomic.LongAdder SWIFT$PACKED_SEARCHES = new java.util.concurrent.atomic.LongAdder();
+
+    public interface SwiftBoxList {
+        void swift$boxChanged(Entity entity);
+    }
+
+    /** Rebuilds the lists whose boxes changed during the parallel phase. Called right after it, on the main thread. */
+    public static void swift$refreshStale() {
+        BasicEntityList<?> list;
+        while ((list = SWIFT$STALE.poll()) != null) {
+            list.swift$refresh();
+        }
+    }
+    // Swift end - packed boxes
+
+    private static final class BasicEntityList<E extends Entity> implements SwiftBoxList { // Swift - packed boxes
 
         private static final Entity[] EMPTY = new Entity[0];
         private static final int DEFAULT_CAPACITY = 4;
@@ -426,6 +454,86 @@ public final class ChunkEntitySlices {
         private E[] storage;
         private int size;
         private int swift$tombstones; // Swift - async entities: slots cleared during the parallel phase, compacted after it
+        // Swift start - packed boxes: minX, minY, minZ, maxX, maxY, maxZ per slot (null for lists without them)
+        private double @org.jspecify.annotations.Nullable [] swift$boxes;
+        private volatile boolean swift$stale;
+
+        private void swift$enablePacked() {
+            this.swift$boxes = new double[this.storage.length * 6];
+        }
+
+        private void swift$writeBox(final int index, final AABB bb) {
+            final double[] boxes = this.swift$boxes;
+            final int o = index * 6;
+            boxes[o] = bb.minX;
+            boxes[o + 1] = bb.minY;
+            boxes[o + 2] = bb.minZ;
+            boxes[o + 3] = bb.maxX;
+            boxes[o + 4] = bb.maxY;
+            boxes[o + 5] = bb.maxZ;
+        }
+
+        private void swift$attach(final E entity, final int index) {
+            entity.swift$boxList = this;
+            entity.swift$boxIndex = index;
+            if (io.papermc.paper.swift.async.SwiftAsync.parallel) {
+                this.swift$markStale();
+            } else {
+                this.swift$writeBox(index, entity.getBoundingBox());
+            }
+        }
+
+        private void swift$detach(final E entity) {
+            if (entity.swift$boxList == this) {
+                entity.swift$boxList = null;
+            }
+        }
+
+        @Override
+        public void swift$boxChanged(final Entity entity) {
+            if (io.papermc.paper.swift.async.SwiftAsync.parallel) {
+                this.swift$markStale();
+                return;
+            }
+            final int index = entity.swift$boxIndex;
+            if (index < this.size && this.storage[index] == entity && this.swift$boxes != null) {
+                this.swift$writeBox(index, entity.getBoundingBox());
+            } else {
+                this.swift$refresh(); // cannot happen; repair rather than read a wrong box
+            }
+        }
+
+        private void swift$markStale() {
+            if (!this.swift$stale) {
+                synchronized (this) {
+                    if (!this.swift$stale) {
+                        this.swift$stale = true;
+                        SWIFT$STALE.add(this);
+                    }
+                }
+            }
+        }
+
+        /** Copies every entity's box and slot again (after the parallel phase or a compaction). */
+        private void swift$refresh() {
+            if (this.swift$boxes == null) {
+                return;
+            }
+            if (this.swift$boxes.length < this.storage.length * 6) {
+                this.swift$boxes = new double[this.storage.length * 6];
+            }
+            final E[] storage = this.storage;
+            for (int i = 0, len = this.size; i < len; ++i) {
+                final E entity = storage[i];
+                if (entity != null) {
+                    entity.swift$boxList = this;
+                    entity.swift$boxIndex = i;
+                    this.swift$writeBox(i, entity.getBoundingBox());
+                }
+            }
+            this.swift$stale = false;
+        }
+        // Swift end - packed boxes
 
         public BasicEntityList() {
             this(0);
