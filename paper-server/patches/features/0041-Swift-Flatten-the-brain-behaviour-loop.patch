+    // Swift start - flat behaviour loop
+    public static boolean SWIFT_FLAT_LOOP = Boolean.parseBoolean(System.getProperty("swift.flatBrainLoop", "true")); // not final: tests compare both paths
+    private int swift$behaviorsVersion;
+    private @Nullable SwiftFlat<E> swift$flat;
+
+    /** Snapshot of availableBehaviorsByPriority in its own iteration order; rebuilt whenever it changes. */
+    private static final class SwiftFlat<E extends LivingEntity> {
+        final int version;
+        final Activity[] groupActivity;
+        final BehaviorControl<? super E>[][] groupBehaviors;
+        final BehaviorControl<? super E>[] all;
+
+        @SuppressWarnings("unchecked")
+        SwiftFlat(final int version, final Map<Integer, Map<Activity, Set<BehaviorControl<? super E>>>> byPriority) {
+            this.version = version;
+            final List<Activity> activities = new java.util.ArrayList<>();
+            final List<BehaviorControl<? super E>[]> groups = new java.util.ArrayList<>();
+            final List<BehaviorControl<? super E>> all = new java.util.ArrayList<>();
+            for (final Map<Activity, Set<BehaviorControl<? super E>>> byActivity : byPriority.values()) {
+                for (final Map.Entry<Activity, Set<BehaviorControl<? super E>>> entry : byActivity.entrySet()) {
+                    activities.add(entry.getKey());
+                    final BehaviorControl<? super E>[] group = entry.getValue().toArray(new BehaviorControl[0]);
+                    groups.add(group);
+                    java.util.Collections.addAll(all, group);
+                }
+            }
+            this.groupActivity = activities.toArray(new Activity[0]);
+            this.groupBehaviors = groups.toArray(new BehaviorControl[0][]);
+            this.all = all.toArray(new BehaviorControl[0]);
+        }
+    }
+
+    private SwiftFlat<E> swift$flat() {
+        SwiftFlat<E> flat = this.swift$flat;
+        if (flat == null || flat.version != this.swift$behaviorsVersion) {
+            flat = new SwiftFlat<>(this.swift$behaviorsVersion, this.availableBehaviorsByPriority);
+            this.swift$flat = flat;
+        }
+        return flat;
+    }
+
+    /** The fast loop's activity gate (one place, so shadow verification checks the real thing). */
+    private boolean swift$groupActive(final Activity activity) {
+        return this.activeActivities.contains(activity);
+    }
+
+    /**
+     * Shadow verification: vanilla's nested walk does the real work; the flat snapshot is walked in
+     * lockstep and must offer the same group, the same gate decision at that moment, and the same
+     * behaviours in the same order.
+     */
+    private void swift$startWithShadow(final ServerLevel level, final E body, final long time) {
+        io.papermc.paper.swift.SwiftVerify.checked();
+        final SwiftFlat<E> flat = this.swift$flat();
+        boolean ok = true;
+        int g = 0;
+        for (final Map<Activity, Set<BehaviorControl<? super E>>> byActivity : this.availableBehaviorsByPriority.values()) {
+            for (final Map.Entry<Activity, Set<BehaviorControl<? super E>>> entry : byActivity.entrySet()) {
+                final Activity activity = entry.getKey();
+                final boolean vanillaActive = this.activeActivities.contains(activity);
+                if (ok) {
+                    if (g >= flat.groupActivity.length || flat.groupActivity[g] != activity) {
+                        io.papermc.paper.swift.SwiftVerify.mismatch("Brain flat loop", "group " + g + " is " + activity + " in vanilla");
+                        ok = false;
+                    } else if (this.swift$groupActive(flat.groupActivity[g]) != vanillaActive) {
+                        io.papermc.paper.swift.SwiftVerify.mismatch("Brain flat loop", "gate for " + activity + " differs (vanilla " + vanillaActive + ")");
+                        ok = false;
+                    }
+                }
+                int i = 0;
+                for (final BehaviorControl<? super E> behavior : entry.getValue()) {
+                    if (ok && (i >= flat.groupBehaviors[g].length || flat.groupBehaviors[g][i] != behavior)) {
+                        io.papermc.paper.swift.SwiftVerify.mismatch("Brain flat loop", "group " + g + " index " + i + " " + behavior);
+                        ok = false;
+                    }
+                    i++;
+                    if (vanillaActive && behavior.getStatus() == Behavior.Status.STOPPED) {
+                        behavior.tryStart(level, body, time);
+                    }
+                }
+                if (ok && i != flat.groupBehaviors[g].length) {
+                    io.papermc.paper.swift.SwiftVerify.mismatch("Brain flat loop", "group " + g + " length " + i + " vs " + flat.groupBehaviors[g].length);
+                    ok = false;
+                }
+                g++;
+            }
+        }
+        if (ok && g != flat.groupActivity.length) {
+            io.papermc.paper.swift.SwiftVerify.mismatch("Brain flat loop", "group count " + g + " vs " + flat.groupActivity.length);
+        }
+    }
+    // Swift end - flat behaviour loop
+
