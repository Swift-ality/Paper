+++ b/net/minecraft/world/level/biome/MobSpawnSettings.java
@@ -62,6 +62,7 @@ public class MobSpawnSettings {
     ) {
         this.spawnsByCategory = ImmutableMap.copyOf(spawnsByCategory);
