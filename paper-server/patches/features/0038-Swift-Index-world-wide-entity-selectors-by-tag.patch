From: swiftality <155652101+Swift-ality@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:28:23 +0100
Subject: [PATCH] Swift: Index world-wide entity selectors by tag

@e[tag=X] (no distance/volume) walked every loaded entity. Entities' tag
sets now report every change (SwiftTagSet, also covering the live Bukkit
scoreboard-tag set), and selectors whose filters are all side-effect free
(allow-list of options; nbt=, predicate=, advancements= and anything
unknown keep the full walk) visit only the entities that carry X, in the
same entity-table order. See io.papermc.paper.swift.entity.SelectorEntityIndex.

Benchmark (~3000 entities): @e[tag=X] 72 -> 7 us, @e[type=marker,tag=X] 84 -> 5 us.
Disable with -Dswift.selectorTagIndex=false.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
index 2e260d0918a495df890603a9b714c37ae0fb5afc..7bff90cf6f55eb9a037e66b2a922210b44ed7339 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/EntityLookup.java
@@ -222,7 +222,16 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
      * entity selectors only. See {@link io.papermc.paper.swift.entity.SelectorEntityIndex}.
      */
     public <U extends Entity> void swift$getForSelector(final EntityTypeTest<Entity, U> filter, final AbortableIterationConsumer<U> action) {
-        final Entity[] candidates = this.swift$selectorIndex.candidates(filter, this.entityById::valueIterator);
+        this.swift$getForSelector(filter, null, action);
+    }
+
+    /**
+     * As above for a selector whose matches must all carry {@code requiredTag} and whose filters are side-effect free
+     * (null = no such tag).
+     */
+    public <U extends Entity> void swift$getForSelector(final EntityTypeTest<Entity, U> filter, final @org.jspecify.annotations.Nullable String requiredTag, final AbortableIterationConsumer<U> action) {
+        final int tagCount = requiredTag == null ? 0 : io.papermc.paper.swift.entity.SwiftTagSet.changeCount(requiredTag);
+        final Entity[] candidates = this.swift$selectorIndex.candidates(filter, requiredTag, this.entityById::valueIterator);
         if (candidates == null) {
             this.get(filter, action);
             return;
@@ -239,6 +248,7 @@ public abstract class EntityLookup implements LevelEntityGetter<Entity> {
             }
         }
         this.swift$selectorIndex.checkUnmodifiedSince(modCount);
+        this.swift$selectorIndex.checkTagUnchangedSince(requiredTag, tagCount);
     }
     // Swift end - selector entity index
 
