diff --git a/net/minecraft/world/entity/ai/village/poi/PoiManager.java b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
index 3b07e731e8d16c2b71cb55b85163029cf56fd02e..c97c39519b838b8e54b6350b20d54f730bfa752f 100644
--- a/net/minecraft/world/entity/ai/village/poi/PoiManager.java
+++ b/net/minecraft/world/entity/ai/village/poi/PoiManager.java
@@ -437,8 +437,29 @@ public class PoiManager extends SectionStorage<PoiSection, PoiSection.Packed> im
         this.villageDistanceTracker.propagateUpdates(); // Paper - rewrite chunk system
     }
 
+    // Swift start - per-chunk POI change counters (see io.papermc.paper.swift.poi.EmptySearchCache)
+    private final it.unimi.dsi.fastutil.longs.Long2LongOpenHashMap swift$poiChanges = new it.unimi.dsi.fastutil.longs.Long2LongOpenHashMap();
+
+    /** Sum of the never-decreasing change counters of every chunk column a POI search of this range from pos can look at. */
+    public long swift$poiChangeVersion(final BlockPos pos, final int range) {
+        final int lowerX = net.minecraft.util.Mth.floor(pos.getX() - range) >> 4;
+        final int upperX = net.minecraft.util.Mth.floor(pos.getX() + range) >> 4;
+        final int lowerZ = net.minecraft.util.Mth.floor(pos.getZ() - range) >> 4;
+        final int upperZ = net.minecraft.util.Mth.floor(pos.getZ() + range) >> 4;
+        long sum = 0L;
+        for (int x = lowerX; x <= upperX; ++x) {
+            for (int z = lowerZ; z <= upperZ; ++z) {
+                sum += this.swift$poiChanges.get(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey(x, z));
+            }
+        }
+        return sum;
+    }
+    // Swift end - per-chunk POI change counters
+
     @Override
     public void setDirty(final long sectionPos) { // Paper - public
+        this.swift$poiChanges.addTo(ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkKey( // Swift - per-chunk POI change counters
+            ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionX(sectionPos), ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionZ(sectionPos)), 1L); // Swift - per-chunk POI change counters
         // Paper start - rewrite chunk system
         final int chunkX = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionX(sectionPos);
         final int chunkZ = ca.spottedleaf.moonrise.common.util.CoordinateUtils.getChunkSectionZ(sectionPos);
