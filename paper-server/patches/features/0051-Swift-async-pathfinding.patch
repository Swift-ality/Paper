+    /** Applies every path this navigation requested and has not applied yet (start of the mob's AI step). */
+    public void swift$resolvePending() {
+        while (!this.swift$pending.isEmpty()) {
+            final Path first = this.swift$pending.get(0);
+            if (first.swift$isPending()) {
+                first.swift$resolve(); // swift$onResolved removes it
+            } else {
+                this.swift$removePending(first); // applied elsewhere already
+            }
+        }
+    }
+
+    // by identity: Path.equals compares contents (and two pending requests can come out equal)
+    private void swift$removePending(final Path path) {
+        for (int i = 0; i < this.swift$pending.size(); i++) {
+            if (this.swift$pending.get(i) == path) {
+                this.swift$pending.remove(i);
+                return;
+            }
+        }
+    }
+
+    /**
+     * A requested path's search finished and was filled in: what createPath and moveTo would have done with the
+     * result, now. {@code found} is false when the search found no path (createPath would have returned null).
+     */
+    public void swift$onResolved(final Path path, final boolean found, final int reachRange) {
+        this.swift$removePending(path);
+        if (found && path.getTarget() != null) {
+            this.targetPos = path.getTarget();
+            this.reachRange = reachRange;
+            this.resetStuckTimeout();
+        }
+        if (this.path == path) {
+            if (this.swift$moveToPath == path) {
+                this.swift$moveToPath = null;
+                this.path = this.swift$moveToPrevious;
+                this.swift$moveToPrevious = null;
+                final boolean moving = this.moveTo(found ? path : null, this.swift$moveToSpeed);
+                if (this.swift$moveToEntity) {
+                    if (moving) {
+                        this.lastFailure = 0;
+                        this.pathfindFailures = 0;
+                    } else {
+                        this.pathfindFailures++;
+                        this.lastFailure = net.minecraft.server.MinecraftServer.currentTick;
+                    }
+                }
+            } else if (!found) {
+                this.path = null;
+            }
+            final java.util.List<BlockPos> changes = this.swift$blockChanges;
+            this.swift$blockChanges = null;
+            if (changes != null) {
+                for (final BlockPos pos : changes) {
+                    if (this.shouldRecomputePath(pos)) {
+                        this.recomputePath();
+                        break;
+                    }
+                }
+            }
+        } else if (this.swift$moveToPath == path) {
+            this.swift$moveToPath = null;
+            this.swift$moveToPrevious = null;
+        }
+    }
+    // Swift end
 
