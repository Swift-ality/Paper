+    // Swift start - async pathfinding (SwiftPathfinding): paths requested and not yet applied, in request order;
+    // the pending path moveTo() installed, with the path it replaced and its speed; block changes seen meanwhile
+    private final java.util.ArrayList<Path> swift$pending = new java.util.ArrayList<>(2);
+    private @Nullable Path swift$moveToPath;
+    private @Nullable Path swift$moveToPrevious;
+    private double swift$moveToSpeed;
